{
  "name": "ai-finance-copilot",
  "version": "1.0.0",
  "description": "AI Finance Copilot monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "db:push": "npm run push -w packages/database",
    "db:generate": "npm run generate -w packages/database",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/api"
  },
  "dependencies": {
    "invariant": "^2.2.4",
    "rimraf": "^6.1.3",
    "stackframe": "^1.3.4"
  }
}
