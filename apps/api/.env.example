# ============================================================
#  NestJS Backend — Environment Variables
#  Copy this file to .env and fill in your own values.
#  Run: cp .env.example .env
# ============================================================

# PostgreSQL connection string (from docker-compose or your cloud DB)
DATABASE_URL="postgresql://admin:password@localhost:5432/aifinancedb"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# JWT secret — replace with a long random string in production
JWT_SECRET="replace-me-with-a-long-random-secret"

# Port for the NestJS server
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
