# Auto detect text files and perform LF normalization
* text=auto

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.mjs text eol=lf

# Markup & Config
*.md text eol=lf
*.mdx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.prisma text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf

# Python
*.py text eol=lf

# Shell (always LF)
*.sh text eol=lf

# Windows batch files (always CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
